# 奖学金审核工作台 · 环境变量示例
# 用法：复制成 .env 放在项目根目录，按需修改。
# 已存在的环境变量优先，.env 不会覆盖它们。
#
# ⚠️ .env 里有数据库密码，不要提交到公开仓库。

# ------------------------------------------------------------------ 数据库
# sqlite（默认，本地开发用） | mysql（正式部署用）
WB_DB=mysql

WB_MYSQL_HOST=127.0.0.1
WB_MYSQL_PORT=3306
WB_MYSQL_USER=scholarship
WB_MYSQL_PASSWORD=改成你的密码
WB_MYSQL_DB=scholarship_audit
# 启动时自动建库（需要账号有 CREATE 权限）。宝塔上手建过库后可以设为 0
WB_MYSQL_AUTO_CREATE=1

# ------------------------------------------------------------------ 队列
# 1 = Web 进程内起后台线程跑任务（开发/单人用，省一个进程）
# 0 = 必须由 `python worker.py` 独立进程消费（生产环境推荐）
WB_INLINE_WORKER=0

# ------------------------------------------------------------------ 隐私
# 是否在送模型前把身份证号/手机号/银行卡号/学号本地涂黑。
# 界面上「模型设置」里也能切换（界面设置优先于这里）
WB_MASK_SENSITIVE=0

# ------------------------------------------------------------------ 其他
# 首次启动时的 admin 密码（默认 123456，登录后请立即改）
WB_ADMIN_PWD=123456
# 监听地址与端口（wsgi.py 用）
WB_HOST=127.0.0.1
WB_PORT=8000
# 改了 .html 模板后是否自动重载（生产可关掉省一点点开销）
WB_TEMPLATE_RELOAD=1
# 打开后启动时会打印数据库迁移明细
WB_VERBOSE=0
